.DS_Store
.ruff_cache/

# `go build` in a package-main exercise writes the binary in-tree, and anyone
# running a lesson's own instructions produces one. Never ship them —
# `tutor.py validate` also fails on any content file over 512KB as a backstop.
skills/tutor/curriculum/content/**/exercise/project-concurrent
skills/tutor/curriculum/content/**/exercise/containers-capstone
skills/tutor/curriculum/content/**/exercise/clockwork
skills/tutor/curriculum/content/**/exercise/deploying-go
skills/tutor/curriculum/content/**/exercise/dockerizing-go
skills/tutor/curriculum/content/**/exercise/app/compose-app
skills/tutor/curriculum/content/**/exercise/app/timesvc

# `uv run` and `pytest` inside an exercise write caches and venvs in-tree, and
# anyone running a lesson's own instructions produces them. Never ship them —
# `uv.lock` and `.python-version` ARE committed: they pin the lesson's toolchain
# the way `go.mod` and `go.sum` do for Go.
__pycache__/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.hypothesis/
*.egg-info/
.coverage
htmlcov/
.tox/
.nox/
dist/
build/
