# The obvious first Dockerfile. It works, and it is enormous — it ships the
# entire Go toolchain, the standard library source, and a Debian userland to
# run one statically linkable binary.
#
# Build and measure it before you write your own:
#
#   docker build -f Dockerfile.naive -t timesvc:naive .
#   docker image ls timesvc
#
# Do not edit this file. Your work goes in a new file named Dockerfile.

FROM golang:1.22-bookworm

WORKDIR /src
COPY . .
RUN go build -o /timesvc .

EXPOSE 8080
CMD ["/timesvc"]
