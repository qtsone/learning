# Copy this file to .env — Compose loads .env automatically and substitutes
# these values into ${...} placeholders in compose.yaml.
#
#   cp .env.example .env
#
# .env is per-machine and holds secrets, so it never goes into git.
# .env.example is the committed documentation of what .env must contain.

POSTGRES_PASSWORD=change-me
APP_PORT=8080
